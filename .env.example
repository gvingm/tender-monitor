# TenderPlan (ключ 128 символов; используется как Bearer-токен в заголовке Authorization)
TENDERPLAN_KEY=<128 chars from tenderplan.ru>
# Tenderplan_API_Key=   # старое имя — тоже поддерживается (fallback)

# Kimi (Moonshot)
KIMI_KEY=<from moonshot.ai>
# Kimi_API_Key=         # старое имя — тоже поддерживается (fallback)

# Mail Assistant HMAC secret
MAIL_SECRET=<openssl rand -hex 32>

# Lark (Feishu) — для Bitable + уведомлений в группу
LARK_APP_ID=cli_xxxxxxxxxxxx        # fallback: Lark_App_ID
LARK_APP_SECRET=<from open.larksuite.com app credentials>   # fallback: Lark_App_Secret
# LARK_BITABLE_APP=AppToken (X37KbBltZaqSSdsGyJdumNLFtmh)
# LARK_BITABLE_TABLE=tblId (tblalXw0gAIi3pVc)
# LARK_CHAT_ID=oc_... (oc_6cc3a4c2e69b74e6a7d240c1e95db951)

# Доставка ежедневной сводки
# TELEGRAM_CHAT_ID=<id группы Telegram, напр. -100xxxxxxxxxx> (токен бота уже выше: Telegram_Bot_Token)
# MAX_BOT_TOKEN=<токен бота MAX из MasterBot>
# MAX_CHAT_ID=<id чата/группы MAX>
