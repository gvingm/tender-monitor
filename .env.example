# TenderPlan
TENDERPLAN_KEY=<128 chars from tenderplan.ru>

# Kimi (Moonshot)
KIMI_KEY=<from moonshot.ai>

# Mail Assistant HMAC secret
MAIL_SECRET=<openssl rand -hex 32>

# Lark (Feishu) — для Bitable + уведомлений в группу
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=<from open.larksuite.com app credentials>
